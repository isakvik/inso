// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Zed's "system" shell here is Windows PowerShell 5.1: scripts in the cwd need a
// ".\" prefix, and there is no "&&" (pwsh 7+ only). Zed also has no task deps, so
// build+debug is sequenced with ";" and bails on a failed compile.
[
  {
    "label": "build",
    "command": ".\\build.bat",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "build + debug",
    "command": ".\\build.bat; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; python debug.py",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "on_success",
    "shell": "system",
  },
  {
    "label": "debug (raddbg)",
    "command": "python debug.py",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "reveal_target": "dock",
    "hide": "always",
    "shell": "system",
  },
  {
    "label": "run.sh [linux]",
    "command": "./run.sh",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "reveal_target": "dock",
    "hide": "always",
    "shell": "system",
  },
]
