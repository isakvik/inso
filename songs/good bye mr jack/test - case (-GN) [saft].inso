inso file format v1

[General]
LuaEntryPoint: test.lua
DoubleMouse: 0
Backbuffer: 1

[ForceSettings]

[Shaders]
[[blur_h]]
VertexShader: builtin.quad
FragmentShader: blur_h.fs.glsl
BlendMode: None

[[blur_v]]
VertexShader: builtin.quad
FragmentShader: blur_v.fs.glsl
BlendMode: None

[[composite]]
VertexShader: builtin.quad
FragmentShader: composite.fs.glsl
BlendMode: Additive

[[crt]]
VertexShader: builtin.quad
FragmentShader: crt_lottes.fs.glsl
BlendMode: None

[[mesh]]
VertexShader: mesh.vs.glsl
FragmentShader: mesh.fs.glsl
BlendMode: Alpha
DepthWrite: 1

[Buffers]
[[my_model]]
Source: Crate1.gltf

[RenderTargets]
[[scene]]
Format: rgba16f
Depth: 1

[[mesh_scene]]
Depth: 1

[[bloom_a]]
Size: 50%

[[bloom_b]]
Size: 50%

[HitObjectExtraBits]
